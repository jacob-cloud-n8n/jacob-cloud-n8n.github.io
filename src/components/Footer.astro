  </div>
  <div class="container copyright">© 小牧人羊奶 Pastoral Harmony. All Rights Reserved.</div>
</footer>

<style>
  .site-footer {
    margin-top: 40px;
    border-top: 1px solid rgba(130, 117, 97, 0.14);
    background: rgba(245, 242, 234, 0.62);
    padding: 52px 0 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;
  }

  .footer-logo {
    width: 120px;
    margin-bottom: 12px;
  }

  p {
    max-width: 440px;
    margin: 0;
    color: rgba(62, 54, 46, 0.72);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    color: rgba(62, 54, 46, 0.74);
    font-weight: 700;
  }

  .footer-links a:hover {
    color: var(--color-primary-strong);
  }

  .footer-social {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }

  .footer-social a {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(141, 163, 153, 0.18);
    color: rgba(62, 54, 46, 0.72);
    transition: background 180ms ease, color 180ms ease;
  }

  .footer-social a:hover {
    background: var(--color-primary);
    color: var(--color-primary-strong);
  }

  .footer-social .icon {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .copyright {
    margin-top: 36px;
    color: rgba(62, 54, 46, 0.56);
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>
