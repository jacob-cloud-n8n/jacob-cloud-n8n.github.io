---
import type { BrandEntry } from "@lib/content";

interface Props {
  entries: BrandEntry[];
}

const { entries } = Astro.props;
const images = ["/images/goat-field.webp", "/images/product-board.webp", "/images/brand-timeline.webp", "/images/line-card.webp"];
---

<div class="timeline">
  {entries.map((entry, index) => (
    <article class:list={["timeline-item", { reverse: index % 2 === 1 }]}>
      <div class="timeline-media">
        <img src={images[index % images.length]} alt={entry.title} width="640" height="480" loading="lazy" />
      </div>
      <div class="timeline-copy">
        <span>Step {index + 1}</span>
        <h2>{entry.title}</h2>
        <p>{entry.richContent}</p>
      </div>
      <i aria-hidden="true"></i>
    </article>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 76px;
    margin-top: 70px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background-image: linear-gradient(var(--color-muted) 50%, transparent 0);
    background-size: 2px 18px;
    opacity: 0.8;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 92px;
    align-items: center;
  }

  .timeline-item.reverse .timeline-media {
    order: 2;
  }

  .timeline-item.reverse .timeline-copy {
    text-align: right;
  }

  .timeline-media {
    overflow: hidden;
    border-radius: 18px 30px 22px 26px;
    box-shadow: var(--shadow-soft);
  }

  .timeline-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 400ms ease, rotate 400ms ease;
  }

  .timeline-media:hover img {
    transform: scale(1.04) rotate(1deg);
  }

  .timeline-copy span {
    color: var(--color-primary);
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .timeline-copy h2 {
    margin: 6px 0 12px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.18;
  }

  .timeline-copy p {
    margin: 0;
    color: rgba(62, 54, 46, 0.74);
    font-size: 1.06rem;
  }

  i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    border: 4px solid var(--color-background);
    border-radius: 999px;
    background: var(--color-primary);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 1px rgba(124, 88, 0, 0.08);
  }

  @media (max-width: 760px) {
    .timeline {
      gap: 44px;
      margin-top: 44px;
      padding-left: 22px;
    }

    .timeline::before {
      left: 0;
    }

    .timeline-item,
    .timeline-item.reverse {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .timeline-item.reverse .timeline-media {
      order: 0;
    }

    .timeline-item.reverse .timeline-copy {
      text-align: left;
    }

    i {
      top: 20px;
      left: 0;
    }
  }
</style>
