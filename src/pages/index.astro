---
import MainLayout from "@layouts/MainLayout.astro";
import { fallbackProducts, type Product } from "@lib/content";
import { getNews, getPageCopy, getProducts } from "@lib/notion";
import { copyImage, copyText } from "@lib/page-copy";
import { siteNavigation } from "@lib/site";

const pageCopy = await getPageCopy();
const allProducts = await getProducts();
const latestNews = (await getNews()).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const homeProductFallbacks = fallbackProducts.slice(0, 3);
const products = homeProductFallbacks.map((fallback, index): Product => {
  const key = `home.products.${index + 1}`;
  const sourceName = copyText(pageCopy, `${key}.sourceName`, fallback.name);
  const matchedProduct = allProducts.find((product) => product.name === sourceName) ?? fallback;
  const priceText = copyText(pageCopy, `${key}.price`, String(matchedProduct.price));

  return {
    ...matchedProduct,
    name: copyText(pageCopy, `${key}.name`, matchedProduct.name),
    desc: copyText(pageCopy, `${key}.desc`, matchedProduct.desc),
    price: Number.parseInt(priceText.replace(/[^\d]/g, ""), 10) || matchedProduct.price,
    image: copyImage(pageCopy, `${key}.image`, matchedProduct.image)
  };
});
---

<MainLayout
  title="小牧人羊奶｜讓每一口鮮乳都充滿陽光的溫度"
  description="小牧人羊奶提供鮮羊乳、優酪乳、手作甜點與週配訂購服務，從牧場直送到餐桌，喝得到新鮮與安心。"
  path="/"
>
  <main>
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="pill">{copyText(pageCopy, "home.hero.pill", "清晨鮮奶直送，讓人安心的風味")}</span>
          <h1 set:html={copyText(pageCopy, "home.hero.title", "讓每一口鮮乳<br />都充滿陽光的溫度")}></h1>
          <p>{copyText(pageCopy, "home.hero.description", "「小牧人」不只是品牌，更是對土地的承諾。在清晨的露水與金色陽光中，為您的家人遞上一瓶最純粹的營養。")}</p>
          <div class="cta-row">
            <a class="button" href="/delivery/">立即訂購</a>
            <a class="button secondary" href="/line/">加入官方 line</a>
          </div>
        </div>
        <div class="hero-card">
          <img class="cms-image-cover" src={copyImage(pageCopy, "home.hero.image", "/images/goat-field.webp")} alt="陽光牧場中的小羊" width="720" height="720" />
          <div class="rating-card">
            <strong>{copyText(pageCopy, "home.hero.badgeTitle", "100% 天然")}</strong>
            <span>{copyText(pageCopy, "home.hero.badgeText", "牧場冷鏈直送，守護鮮乳純淨風味。")}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section news-band">
      <div class="container">
        <div class="center-head">
            <h2>{copyText(pageCopy, "home.news.title", "最新消息")}</h2>
        </div>
        <div class="news-grid">
          {latestNews.map((item) => (
            <a class="news-card" href={`/news/${item.slug}/`}>
              <time>{item.date}</time>
              <h3>{item.title}</h3>
              <p>{item.excerpt}</p>
              <span>閱讀更多 +</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="split-head">
          <div>
            <h2>{copyText(pageCopy, "home.products.title", "精選牧人風味")}</h2>
            <p>{copyText(pageCopy, "home.products.description", "讓每日鮮乳、優酪乳與手作甜點，成為餐桌上的小小期待。")}</p>
          </div>
          <a href="/products/">查看全部商品 →</a>
        </div>
        <div class="home-product-grid">
          {products.map((product) => (
            <article class="home-product-card">
              <div class="product-orb">
                <img class="cms-image-cover" src={product.image} alt={product.name} width="260" height="260" loading="lazy" />
              </div>
              <h3>{product.name}</h3>
              <p>{product.desc}</p>
              <div class="home-product-meta">
                <strong>NT$ {product.price}</strong>
                <a href="/delivery/" aria-label={`訂購 ${product.name}`}>
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 8h15l-2 8H8L6 4H3" />
                    <path d="M9 20h.01M18 20h.01" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section trust-section">
      <div class="container">
        <div class="center-head">
          <h2>小牧人的堅持</h2>
          <p>從牧場到餐桌，我們用行動證明品質</p>
        </div>
        <div class="trust-grid">
          <a class="trust-card" href="https://youtu.be/9AWN-1hHRwI?si=Ok5UJNGmgBWjRJs6&t=5" target="_blank" rel="noopener noreferrer">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.13C5.12 19.56 12 19.56 12 19.56s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.46z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
            </div>
            <strong>網紅來訪</strong>
            <span>許伯簡芝光復新村美食推薦</span>
          </a>
          <a class="trust-card" href="https://www.peopo.org/news/837891" target="_blank" rel="noopener noreferrer">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
            </div>
            <strong>公民新聞採訪</strong>
            <span>小牧人的選擇 一場創業的夢想</span>
          </a>
          <a class="trust-card" href="https://youtu.be/9II2L8QHOck?si=5AmTeWTmhsV9Oe63&t=15" target="_blank" rel="noopener noreferrer">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
            </div>
            <strong>三立電視採訪</strong>
            <span>上山下海過一夜 光復新村專題</span>
          </a>
          <div class="trust-card">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <strong>羊隻定期健康檢查</strong>
            <span>南投縣家畜疾病防治所檢驗合格</span>
          </div>
          <a class="trust-card" href="https://youtu.be/UktuQYAnOqU?si=nd5tOi3p-K6Dlyuq" target="_blank" rel="noopener noreferrer">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <strong>牧場紀錄</strong>
            <span>小牧人羊奶牧場直擊</span>
          </a>
          <a class="trust-card" href="https://www.tiktok.com/@user7943932814061/video/7470064624310684933" target="_blank" rel="noopener noreferrer">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </div>
            <strong>網紅短片</strong>
            <span>TikTok 網紅拍攝推薦</span>
          </a>
          <a class="trust-card" href="https://travel.udn.com/travel/story/7207/7663704" target="_blank" rel="noopener noreferrer">
            <div class="trust-icon">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
            </div>
            <strong>聯合新聞網採訪</strong>
            <span>光復新村旅遊專題報導</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section subscribe-section">
      <div class="container subscribe-card">
        <h2 set:html={copyText(pageCopy, "home.subscribe.title", "現在訂閱，<br />開啟您的晨間牧場食光")}></h2>
        <p>{copyText(pageCopy, "home.subscribe.description", "加入我們的配送方案，每週三次新鮮直送，讓全家人的健康從一瓶羊奶開始。")}</p>
        <div class="subscribe-form">
          <a class="button" href="/delivery/">{copyText(pageCopy, "home.subscribe.button", "立即訂閱配送")}</a>
          <a class="button secondary-light" href={siteNavigation.googleMapsUrl} target="_blank" rel="noopener noreferrer">
            {copyText(pageCopy, "home.subscribe.navigationButton", `導航到${siteNavigation.name}`)}
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .home-hero {
    margin-top: -82px;
    padding: 180px 0 96px;
    background: linear-gradient(120deg, #fff8f3 0%, #fff2df 52%, #f8fbef 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.88fr;
    gap: 58px;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    border-radius: 999px;
    padding: 8px 16px;
    background: rgba(141, 163, 153, 0.2);
    color: #4e635a;
    font-size: 0.86rem;
    font-weight: 900;
  }

  h1 {
    margin: 22px 0 18px;
    color: #3e2f12;
    font-size: clamp(3rem, 7vw, 5.8rem);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .hero-copy p {
    max-width: 610px;
    margin: 0 0 30px;
    color: rgba(62, 54, 46, 0.76);
    font-size: 1.14rem;
  }

  .hero-card {
    position: relative;
    justify-self: center;
    width: min(100%, 440px);
  }

  .hero-card img {
    aspect-ratio: 0.82;
    width: 100%;
    object-fit: cover;
    border-radius: 42px 42px 54px 54px;
    box-shadow: 0 26px 60px rgba(62, 54, 46, 0.16);
  }

  .rating-card {
    position: absolute;
    bottom: -22px;
    left: -44px;
    width: 210px;
    border-radius: 18px;
    padding: 18px;
    background: #fff8f3;
    box-shadow: var(--shadow-soft);
  }

  .rating-card strong {
    display: block;
    color: var(--color-primary-strong);
  }

  .rating-card span {
    color: rgba(62, 54, 46, 0.68);
    font-size: 0.86rem;
  }

  .trust-section {
    background: rgba(245, 226, 197, 0.5);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 36px;
  }

  .trust-card {
    display: grid;
    justify-items: center;
    border: 1px solid rgba(130, 117, 97, 0.12);
    border-radius: 18px;
    padding: 28px 20px;
    background: rgba(255, 248, 243, 0.94);
    box-shadow: 0 10px 24px rgba(62, 54, 46, 0.07);
    text-align: center;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .trust-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .trust-icon {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    border-radius: 999px;
    background: rgba(243, 178, 27, 0.16);
    color: var(--color-primary-strong);
    margin-bottom: 14px;
  }

  .trust-icon .icon {
    width: 26px;
    height: 26px;
  }

  .trust-card strong {
    color: var(--color-primary-strong);
    font-size: 1.05rem;
  }

  .trust-card span {
    margin-top: 6px;
    color: rgba(62, 54, 46, 0.64);
    font-size: 0.88rem;
  }

  .news-band {
    background: rgba(245, 226, 197, 0.5);
  }

  .center-head {
    text-align: center;
  }

  .center-head h2,
  .split-head h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }

  .news-grid,
  .home-product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .home-product-grid {
    max-width: 900px;
    margin-inline: auto;
  }

  .home-product-card {
    display: grid;
    justify-items: center;
    border: 1px solid rgba(130, 117, 97, 0.12);
    border-radius: 22px;
    padding: 24px 22px 22px;
    background: rgba(255, 248, 243, 0.94);
    box-shadow: 0 14px 32px rgba(62, 54, 46, 0.08);
    text-align: center;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .home-product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .product-orb {
    width: min(72vw, 284px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 6px solid #fff;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(130, 117, 97, 0.08), 0 10px 22px rgba(62, 54, 46, 0.08);
  }

  .product-orb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-product-card h3 {
    margin: 22px 0 6px;
    font-size: 1.14rem;
  }

  .home-product-card p {
    min-height: 48px;
    margin: 0;
    color: rgba(62, 54, 46, 0.64);
    font-size: 0.92rem;
  }

  .home-product-meta {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
  }

  .home-product-meta strong {
    color: var(--color-primary-strong);
  }

  .home-product-meta a {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-primary-strong);
    transition: transform 180ms ease;
  }

  .home-product-meta a:hover {
    transform: scale(1.08);
  }

  .news-card {
    min-height: 190px;
    border: 1px solid rgba(130, 117, 97, 0.12);
    border-radius: 18px;
    padding: 24px;
    background: rgba(255, 248, 243, 0.9);
    box-shadow: 0 10px 24px rgba(62, 54, 46, 0.07);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  time {
    display: inline-flex;
    border-radius: 999px;
    padding: 4px 9px;
    background: rgba(141, 163, 153, 0.18);
    color: #4e635a;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .news-card h3 {
    margin: 14px 0 8px;
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .news-card p {
    color: rgba(62, 54, 46, 0.68);
    font-size: 0.92rem;
  }

  .news-card span,
  .split-head a {
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  .split-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .split-head p {
    margin: 8px 0 0;
    color: rgba(62, 54, 46, 0.66);
  }

  .subscribe-card {
    max-width: 880px;
    border-radius: 34px;
    padding: 58px 34px;
    background: #3f6256;
    color: #fff8f3;
    text-align: center;
    box-shadow: 0 18px 48px rgba(63, 98, 86, 0.22);
  }

  .subscribe-card h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.08;
  }

  .subscribe-card p {
    max-width: 560px;
    margin: 18px auto 26px;
    color: rgba(255, 248, 243, 0.84);
  }

  .subscribe-form {
    display: flex;
    width: min(100%, 680px);
    gap: 12px;
    margin-inline: auto;
    justify-content: center;
  }

  .subscribe-form .button {
    min-width: min(100%, 250px);
    white-space: nowrap;
  }

  .subscribe-form .secondary-light {
    border: 1px solid rgba(255, 248, 243, 0.72);
    background: rgba(255, 248, 243, 0.94);
    color: #3f6256;
  }

  .subscribe-form .secondary-light:hover {
    background: #fff8f3;
  }

  @media (max-width: 860px) {
    .home-hero {
      padding-top: 152px;
    }

    .hero-grid,
    .news-grid,
    .home-product-grid {
      grid-template-columns: 1fr;
    }

    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-card {
      width: min(100%, 360px);
    }

    .rating-card {
      right: 12px;
      left: auto;
    }

    .split-head,
    .subscribe-form {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
