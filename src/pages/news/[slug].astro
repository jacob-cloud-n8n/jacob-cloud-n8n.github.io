---
import MainLayout from "@layouts/MainLayout.astro";
import { getNews } from "@lib/notion";

export const prerender = true;

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const youtubeId = item.youtubeUrl?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?/]+)/)?.[1];
---

<MainLayout
  title={`${item.title}｜小牧人羊奶最新消息`}
  description={`${item.excerpt} 小牧人羊奶最新消息與新品介紹。`}
  path={`/news/${item.slug}/`}
>
  <main>
    <article class="news-detail">
      <div class="container detail-grid">
        <div class="article-main">
          <a class="back-link" href="/news/">首頁 / 最新消息 / 文章內文</a>
          <span class="category">{item.category}</span>
          <time>{item.date}</time>
          <h1>{item.title}</h1>
          <img src={item.image} alt={item.title} width="900" height="560" />
          {item.content.map((paragraph) => <p>{paragraph}</p>)}
          <section class="highlight">
            <h2>{item.highlightTitle}</h2>
            <p>{item.highlightContent}</p>
          </section>
          {youtubeId && (
            <div class="video-embed">
              <iframe
                src={`https://www.youtube.com/embed/${youtubeId}`}
                title={`${item.title} YouTube 影片`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          )}
        </div>
        <aside class="side-card">
          <img src="/images/product-board.webp" alt="瓶裝羊奶" width="320" height="420" />
          <strong>特調巧克力羊奶</strong>
          <span>NT$ 70</span>
          <a class="button" href="/delivery/">立即訂購</a>
          <div class="share-box">
            <b>文章重點</b>
            <p>{item.excerpt}</p>
          </div>
        </aside>
      </div>
    </article>
  </main>
</MainLayout>

<style>
  .news-detail {
    margin-top: -82px;
    padding: 138px 0 80px;
    background: linear-gradient(180deg, #fff8f3, #fff1df 58%, #3d3328 58%);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 34px;
    align-items: start;
  }

  .article-main {
    border-radius: 28px;
    padding: 34px;
    background: rgba(255, 248, 243, 0.95);
    box-shadow: var(--shadow-soft);
  }

  .back-link {
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  .category {
    display: inline-flex;
    margin-top: 22px;
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--color-primary);
    color: var(--color-primary-strong);
    font-size: 0.85rem;
    font-weight: 900;
  }

  time {
    display: block;
    margin-top: 12px;
    color: var(--color-accent);
    font-weight: 900;
  }

  h1 {
    margin: 8px 0 24px;
    color: var(--color-primary-strong);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
  }

  .article-main > img {
    width: 100%;
    aspect-ratio: 1.65;
    object-fit: cover;
    border: 8px solid #fff;
    border-radius: 24px;
  }

  p {
    color: rgba(62, 54, 46, 0.76);
    font-size: 1.04rem;
  }

  .highlight {
    margin: 24px 0;
    border-radius: 18px;
    padding: 24px;
    background: #fff1dc;
  }

  .video-embed {
    overflow: hidden;
    margin-top: 26px;
    border-radius: 22px;
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .video-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .highlight h2 {
    margin: 0 0 8px;
    color: var(--color-primary-strong);
  }

  .side-card {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 14px;
    border-radius: 22px;
    padding: 18px;
    background: #f4dfbf;
    box-shadow: var(--shadow-soft);
  }

  .side-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
  }

  .side-card strong {
    font-size: 1.1rem;
  }

  .side-card span {
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  .share-box {
    border-radius: 14px;
    padding: 16px;
    background: rgba(255, 248, 243, 0.78);
  }

  .share-box p {
    margin: 6px 0 0;
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .side-card {
      position: static;
    }
  }
</style>
