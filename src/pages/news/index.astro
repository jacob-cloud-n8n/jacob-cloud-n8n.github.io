---
import MainLayout from "@layouts/MainLayout.astro";
import { fallbackNews } from "@lib/content";
---

<MainLayout
  title="最新消息｜小牧人羊奶新品、牧場日誌與優惠"
  description="查看小牧人羊奶最新消息，包含新品上市、牧場週配日誌、通路優惠與活動公告。"
  path="/news/"
>
  <main>
    <section class="news-list-page">
      <div class="container">
        <div class="news-head">
          <span>News</span>
          <h1>最新消息</h1>
          <p>新品、牧場日誌、配送公告與限定優惠都會集中在這裡，也可由 Notion 後台替換圖文內容。</p>
        </div>
        <div class="news-list">
          {fallbackNews.map((item) => (
            <a class="news-item" href={`/news/${item.slug}/`}>
              <img src={item.image} alt={item.title} width="360" height="240" loading="lazy" />
              <div>
                <span>{item.category}</span>
                <time>{item.date}</time>
                <h2>{item.title}</h2>
                <p>{item.excerpt}</p>
                <b>閱讀更多 +</b>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .news-list-page {
    margin-top: -82px;
    padding: 142px 0 86px;
    background: linear-gradient(180deg, #fff8f3, #fff1df);
  }

  .news-head {
    text-align: center;
  }

  .news-head > span {
    display: inline-flex;
    border-radius: 999px;
    padding: 7px 14px;
    background: rgba(243, 178, 27, 0.16);
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  h1 {
    margin: 16px 0 10px;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.08;
  }

  .news-head p {
    max-width: 680px;
    margin: 0 auto;
    color: rgba(62, 54, 46, 0.7);
  }

  .news-list {
    display: grid;
    gap: 22px;
    max-width: 900px;
    margin: 46px auto 0;
  }

  .news-item {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    border-radius: 24px;
    padding: 18px;
    background: rgba(255, 248, 243, 0.92);
    box-shadow: var(--shadow-soft);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .news-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .news-item img {
    width: 100%;
    height: 100%;
    min-height: 180px;
    object-fit: cover;
    border-radius: 18px;
  }

  .news-item span,
  time,
  b {
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  time {
    margin-left: 12px;
    color: rgba(62, 54, 46, 0.58);
  }

  h2 {
    margin: 10px 0;
    font-size: 1.55rem;
    line-height: 1.25;
  }

  .news-item p {
    color: rgba(62, 54, 46, 0.68);
  }

  @media (max-width: 760px) {
    .news-item {
      grid-template-columns: 1fr;
    }
  }
</style>
