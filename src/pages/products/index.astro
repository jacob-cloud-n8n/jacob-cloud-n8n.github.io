---
import MainLayout from "@layouts/MainLayout.astro";
import { getPageCopy, getProducts } from "@lib/notion";
import { copyImage, copyText } from "@lib/page-copy";

const pageCopy = await getPageCopy();
const products = await getProducts();
const fresh = products.filter((product) => product.category === "鮮乳" || product.category === "優酪乳");
const drinks = products.filter((product) => product.category === "特調飲品");
const sweets = products.filter((product) => product.category === "甜點");
const sweetExtraImage = copyImage(pageCopy, "products.sweets.extra.title", "");
const sweetExtraLabel = copyText(pageCopy, "products.sweets.extra.title", "甜點系列補充圖片欄位");
---

<MainLayout
  title="商品廚窗｜小牧人羊奶鮮乳、甜點與特調飲品"
  description="瀏覽小牧人羊奶商品廚窗，包含純羊奶、羊初乳、羊奶布丁、甜點系列與多款特調飲品。"
  path="/products/"
>
  <main>
    <section class="section catalog-hero">
      <div class="container center-head">
        <h1>{copyText(pageCopy, "products.hero.title", "純淨牧場的自然滋味")}</h1>
        <p>{copyText(pageCopy, "products.hero.description", "從農場第一滴鮮羊乳開始，我們堅持職人手作，將牧場清新與溫潤轉化為餐桌上的健康美味。")}</p>
      </div>
    </section>

    <section class="catalog-section">
      <div class="container catalog-layout">
        <article class="fresh-panel">
          <span>{copyText(pageCopy, "products.fresh.badge", "皇室首選")}</span>
          <h2>{copyText(pageCopy, "products.fresh.title", "鮮乳系列")}</h2>
          <p>{copyText(pageCopy, "products.fresh.description", "低溫殺菌，保留最完整的營養與活性分子，醇厚卻清爽。")}</p>
          <div class="mini-grid">
            {fresh.map((product) => (
              <a href="/delivery/">
                <img class="cms-image-cover" src={product.image} alt={product.name} width="240" height="180" loading="lazy" />
                <strong>{product.name}</strong>
                <small>{product.desc}</small>
                <b>NT$ {product.price}</b>
              </a>
            ))}
          </div>
        </article>
        <aside class="sweet-panel">
          <h2>{copyText(pageCopy, "products.sweets.title", "甜點系列")}</h2>
          <p>{copyText(pageCopy, "products.sweets.description", "天然羊奶入料，細滑香Q的極致口感。")}</p>
          {sweets.map((product) => (
            <a href="/delivery/">
              <img class="cms-image-cover" src={product.image} alt={product.name} width="180" height="150" loading="lazy" />
              <span>
                <strong>{product.name}</strong>
                <small>{product.desc}</small>
              </span>
              <b>NT$ {product.price}</b>
            </a>
          ))}
          <div class="image-field" aria-label="可自由加入甜點圖片的欄位">
            {sweetExtraImage ? (
              <img class="cms-image-contain" src={sweetExtraImage} alt={sweetExtraLabel} width="360" height="220" loading="lazy" />
            ) : (
              <span>{sweetExtraLabel}</span>
            )}
          </div>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="container drink-panel">
        <h2>{copyText(pageCopy, "products.drinks.title", "特調飲品")}</h2>
        <div class="drink-grid">
          {drinks.map((product) => (
            <a href="/delivery/">
              <strong>{product.name}</strong>
              <b>NT$ {product.price}</b>
              <small>{product.desc}</small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section delivery-note">
      <div class="container note-card">
        <div>
          <h2>{copyText(pageCopy, "products.note.title", "每日牧場直送")}</h2>
          <p>{copyText(pageCopy, "products.note.description", "我們相信，只有快樂的羊，才能生產出最好的羊奶。小牧人與在地小農合作，確保每一滴羊奶都源自自然放牧、草飼餵養的健康羊群。")}</p>
          <strong>{copyText(pageCopy, "products.note.badge", "通過 12 道嚴格品管檢驗")}</strong>
        </div>
        <img class="cms-image-cover" src={copyImage(pageCopy, "products.note.image", "/images/goat-field.webp")} alt="每日牧場直送" width="600" height="420" loading="lazy" />
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .catalog-hero {
    padding-top: 96px;
    text-align: center;
  }

  h1 {
    margin: 0;
    color: var(--color-primary-strong);
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1.05;
  }

  .center-head p {
    max-width: 720px;
    margin: 16px auto 0;
    color: rgba(62, 54, 46, 0.72);
  }

  .catalog-section {
    padding-bottom: 40px;
  }

  .catalog-layout {
    display: grid;
    grid-template-columns: 1.5fr 0.85fr;
    gap: 26px;
  }

  .fresh-panel,
  .sweet-panel,
  .drink-panel,
  .note-card {
    border-radius: 26px;
    padding: 34px;
    background: #fff1dc;
    box-shadow: 0 10px 28px rgba(62, 54, 46, 0.08);
  }

  .sweet-panel {
    background: #cfe7dc;
  }

  .fresh-panel > span {
    display: inline-flex;
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--color-primary-strong);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 900;
  }

  h2 {
    margin: 10px 0;
    color: var(--color-primary-strong);
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  p {
    color: rgba(62, 54, 46, 0.72);
  }

  .mini-grid,
  .drink-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .mini-grid a,
  .sweet-panel a,
  .drink-grid a {
    display: grid;
    gap: 7px;
    border-radius: 14px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.78);
  }

  .mini-grid img,
  .sweet-panel img {
    width: 100%;
    height: 136px;
    border-radius: 12px;
    object-fit: cover;
  }

  small {
    color: rgba(62, 54, 46, 0.64);
  }

  b {
    color: var(--color-primary-strong);
  }

  .sweet-panel a {
    grid-template-columns: 86px 1fr auto;
    align-items: center;
    margin-top: 12px;
  }

  .sweet-panel span {
    display: grid;
    gap: 4px;
  }

  .sweet-panel img {
    height: 72px;
  }

  .image-field {
    display: grid;
    min-height: 172px;
    place-items: center;
    margin-top: 18px;
    border: 2px dashed rgba(124, 88, 0, 0.18);
    border-radius: 18px;
    background: rgba(255, 248, 243, 0.52);
  }

  .image-field img {
    max-height: 220px;
    object-fit: contain;
  }

  .image-field span {
    color: rgba(62, 54, 46, 0.42);
    font-weight: 800;
    text-align: center;
  }

  .drink-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .note-card {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 30px;
    align-items: center;
    background: #f1e6d8;
    overflow: hidden;
  }

  .note-card strong {
    color: var(--color-primary-strong);
  }

  .note-card img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    border-radius: 24px;
  }

  @media (max-width: 860px) {
    .catalog-layout,
    .mini-grid,
    .drink-grid,
    .note-card {
      grid-template-columns: 1fr;
    }
  }
</style>
